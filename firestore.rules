rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /parent_notifications/{notificationId} {
      allow read: if request.auth != null
        && (
          resource.data.parentFirebaseUid == request.auth.uid
          || resource.data.teacherFirebaseUid == request.auth.uid
        );

      allow create: if request.auth != null
        && request.resource.data.parentFirebaseUid is string
        && request.resource.data.alertType in [
          'teacherAlert',
          'needsAttention',
          'distress',
          'schoolNeeded'
        ];

      allow update: if request.auth != null
        && resource.data.parentFirebaseUid == request.auth.uid
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['isRead']);
    }

    match /parent_child_links/{linkId} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
        && request.resource.data.parentFirebaseUid == request.auth.uid
        && request.resource.data.learnerFirebaseUid is string;

      allow delete: if request.auth != null
        && (
          resource.data.parentFirebaseUid == request.auth.uid
          || resource.data.learnerFirebaseUid == request.auth.uid
        );
    }

    match /class_enrollments_cloud/{enrollmentId} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
        && request.resource.data.teacherFirebaseUid is string
        && request.resource.data.learnerFirebaseUid is string
        && request.resource.data.classCode is string
        && (
          request.resource.data.learnerFirebaseUid == request.auth.uid
          || request.resource.data.teacherFirebaseUid == request.auth.uid
        );

      allow delete: if request.auth != null
        && (
          resource.data.learnerFirebaseUid == request.auth.uid
          || resource.data.teacherFirebaseUid == request.auth.uid
        );
    }

    match /class_join_requests_cloud/{requestId} {
      allow read: if request.auth != null;

      // The learner creates the request; the teacher rewrites it with the
      // accepted/rejected status, so either side may write their own doc.
      allow create, update: if request.auth != null
        && request.resource.data.learnerFirebaseUid is string
        && request.resource.data.teacherFirebaseUid is string
        && request.resource.data.classCode is string
        && (
          request.resource.data.learnerFirebaseUid == request.auth.uid
          || request.resource.data.teacherFirebaseUid == request.auth.uid
        );

      allow delete: if request.auth != null
        && (
          resource.data.learnerFirebaseUid == request.auth.uid
          || resource.data.teacherFirebaseUid == request.auth.uid
        );
    }

    match /teacher_classes_cloud/{classCode} {
      allow read: if request.auth != null;

      // Stamp live Auth uid on the payload. Update is allowed when the NEW
      // document belongs to the signed-in teacher (so a re-login can reclaim).
      allow create, update: if request.auth != null
        && request.resource.data.teacherFirebaseUid == request.auth.uid
        && request.resource.data.classCode is string
        && request.resource.data.className is string;

      allow delete: if request.auth != null
        && resource.data.teacherFirebaseUid == request.auth.uid;
    }

    match /learner_profiles/{learnerUid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == learnerUid
        && request.resource.data.learnerFirebaseUid == learnerUid;
      allow delete: if request.auth != null && request.auth.uid == learnerUid;
    }

    match /user_profiles/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId
        || resource.data.role == 'learner'
        || resource.data.role == 'teacher'
      );
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /learner_activity/{docId} {
      // Teachers and parents can read; learner writes their own activity.
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.learnerFirebaseUid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.learnerFirebaseUid == request.auth.uid;
    }

    // Lesson phrase images/videos when Firebase Storage is unavailable (Spark).
    match /phrase_media_cloud/{docId} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
        && request.resource.data.teacherFirebaseUid == request.auth.uid;

      allow delete: if request.auth != null
        && resource.data.teacherFirebaseUid == request.auth.uid;
    }

  }
}
